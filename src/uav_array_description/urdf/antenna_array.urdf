<?xml version="1.0"?>
<robot name="antenna_array">

  <!-- Material definitions -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="red"><color rgba="0.8 0 0 1"/></material>

  <!-- Central Hub -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- Arm 1 (Front) -->
  <link name="arm_1">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.005" length="0.2"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="base_to_arm_1" type="fixed">
    <parent link="base_link"/>
    <child link="arm_1"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Sensor 1 -->
  <link name="sensor_1">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="arm_1_to_sensor" type="fixed">
    <parent link="arm_1"/>
    <child link="sensor_1"/>
    <origin xyz="0.2 0 0"/>
  </joint>

  <!-- Arm 2 (Left) -->
  <link name="arm_2">
    <visual>
      <origin xyz="0 0.1 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.005" length="0.2"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="base_to_arm_2" type="fixed">
    <parent link="base_link"/>
    <child link="arm_2"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Sensor 2 -->
  <link name="sensor_2">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="arm_2_to_sensor" type="fixed">
    <parent link="arm_2"/>
    <child link="sensor_2"/>
    <origin xyz="0 0.2 0"/>
  </joint>

  <!-- Arm 3 (Back) -->
  <link name="arm_3">
    <visual>
      <origin xyz="-0.1 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.005" length="0.2"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="base_to_arm_3" type="fixed">
    <parent link="base_link"/>
    <child link="arm_3"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Sensor 3 -->
  <link name="sensor_3">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="arm_3_to_sensor" type="fixed">
    <parent link="arm_3"/>
    <child link="sensor_3"/>
    <origin xyz="-0.2 0 0"/>
  </joint>

  <!-- Arm 4 (Right) -->
  <link name="arm_4">
    <visual>
      <origin xyz="0 -0.1 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.005" length="0.2"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="base_to_arm_4" type="fixed">
    <parent link="base_link"/>
    <child link="arm_4"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Sensor 4 -->
  <link name="sensor_4">
    <visual>
      <geometry><sphere radius="0.015"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="arm_4_to_sensor" type="fixed">
    <parent link="arm_4"/>
    <child link="sensor_4"/>
    <origin xyz="0 -0.2 0"/>
  </joint>

</robot>
